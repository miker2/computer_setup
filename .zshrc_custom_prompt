
# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/opt/miniconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/opt/miniconda3/etc/profile.d/conda.sh" ]; then
        . "/opt/miniconda3/etc/profile.d/conda.sh"
    else
        export PATH="/opt/miniconda3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

if type brew &>/dev/null; then
  FPATH=$(brew --prefix)/share/zsh-completions:$FPATH

  autoload -Uz compinit
  compinit
fi


. "$HOME/.local/bin/env"

setopt promptsubst
autoload -Uz vcs_info
zstyle ':vcs_info;*' enable git  # Only run for git
zstyle ':vcs_info:git*' check-for-changes true
zstyle ':vcs_info:git*' get-revision true
zstyle ':vcs_info:git*' formats '%F{red}(%b)%f'
zstyle ':vcs_info:git*' actionformats '%F{red}(%b|%(S.*%S.)%(u.+%u.))%f'
precmd_conda_info() {
  if [[ -n $CONDA_DEFAULT_ENV ]]; then
    CONDA_PROMPT_MODIFIER="($CONDA_DEFAULT_ENV) "
  else
    CONDA_PROMPT_MODIFIER=""
  fi
}
precmd_functions+=( precmd_conda_info )
precmd_first_line() {
    vcs_info
    print # Newline for clean separation 
    print -rP $'\U256D\U2574'"%F{cyan}$CONDA_PROMPT_MODIFIER%f%F{green}%n@%m%f %F{blue}%0~%f ${vcs_info_msg_0_}" 
}
precmd_functions+=( precmd_first_line )
PROMPT=$'\U2570\U2574'"%(?.%F{green}√%f.%F{red}✗%?%f) %F{blue}%# >%f "
